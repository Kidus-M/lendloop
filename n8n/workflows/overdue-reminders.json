{
  "id": "lendloopOverdue1",
  "name": "LendLoop: overdue reminders",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000025",
      "name": "Every day at 08:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000026",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "parameters": {}
    },
    {
      "id": "00000000-0000-4000-8000-000000000027",
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const timestamp = String(Math.floor(Date.now() / 1000));\nreturn [{\n  json: { timestamp, signingString: `${timestamp}.GET./n8n/overdue-loans.` },\n}];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000028",
      "name": "Sign request",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signingString }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "lendloopHmacOut1",
          "name": "n8n to LendLoop signing key"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000029",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "=v1={{ $json.signature }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "00000000-0000-4000-8000-000000000030",
      "name": "Compose reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { loans } = $input.first().json;\nreturn loans.map((loan) => {\n  const days = loan.daysOverdue === 1 ? \"1 day\" : `${loan.daysOverdue} days`;\n  return {\n    json: {\n      reminderKey: loan.reminderKey,\n      to: loan.recipient.email,\n      subject: `Your ${loan.toolName} is ${days} overdue`,\n      text: `Hi ${loan.recipient.firstName},\\n\\nThe ${loan.toolName} was due back on ${loan.dueDate}. Please return it to its owner soon.\\n\\nLendLoop`,\n    },\n  };\n});"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000031",
      "name": "Send reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "fromEmail": "LendLoop <notifications@lendloop.test>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "lendloopSmtp0001",
          "name": "LendLoop mail"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000034",
      "name": "Mark sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "00000000-0000-4000-8000-000000000032",
              "name": "reminderKey",
              "value": "={{ $('Compose reminders').item.json.reminderKey }}",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-000000000033",
              "name": "status",
              "value": "sent",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000037",
      "name": "Mark failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "00000000-0000-4000-8000-000000000035",
              "name": "reminderKey",
              "value": "={{ $('Compose reminders').item.json.reminderKey }}",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-000000000036",
              "name": "status",
              "value": "failed",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000038",
      "name": "Build write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Serialize once and sign that exact string: the bytes signed are the bytes sent.\nconst body = JSON.stringify({ reminderKey: $json.reminderKey, status: $json.status });\nconst timestamp = String(Math.floor(Date.now() / 1000));\nreturn {\n  json: {\n    body,\n    timestamp,\n    signingString: `${timestamp}.POST./n8n/reminders.${body}`,\n    status: $json.status,\n  },\n};"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000039",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signingString }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "lendloopHmacOut1",
          "name": "n8n to LendLoop signing key"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000040",
      "name": "Report to LendLoop",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "=v1={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
