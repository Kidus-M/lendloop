    {
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Prepare signature check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The signature covers the exact bytes Convex sent, so read the raw body, not the parsed one.\nconst { headers } = $input.first().json;\nlet rawBody = \"\";\ntry {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, \"data\");\n  rawBody = buffer.toString(\"utf8\");\n} catch {\n  // An empty body falls through and fails verification below.\n}\nconst timestamp = headers[\"x-lendloop-timestamp\"] ?? \"\";\nreturn [{\n  json: {\n    rawBody,\n    timestamp,\n    signature: headers[\"x-lendloop-signature\"] ?? \"\",\n    signingString: `${timestamp}.POST./webhook/lendloop-events.${rawBody}`,\n  },\n}];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "name": "Compute expected signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signingString }}",
        "dataPropertyName": "expected",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "lendloopHmacIn01",
          "name": "LendLoop to n8n signing key"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000004",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require(\"crypto\");\nconst MAX_CLOCK_SKEW_SECONDS = 300;\n\nconst { rawBody, timestamp, signature, expected } = $input.first().json;\nconst seconds = Number(timestamp);\nconst fresh =\n  Number.isInteger(seconds) &&\n  Math.abs(Date.now() / 1000 - seconds) <= MAX_CLOCK_SKEW_SECONDS;\n\nconst provided = Buffer.from(String(signature));\nconst computed = Buffer.from(`v1=${expected}`);\nconst matches =\n  provided.length === computed.length &&\n  crypto.timingSafeEqual(provided, computed);\n\nif (!fresh || !matches) return [{ json: { valid: false } }];\nreturn [{ json: { valid: true, event: JSON.parse(rawBody) } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
