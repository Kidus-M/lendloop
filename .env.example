# Used by docker-compose.yml. Create the real file with `npm run setup:secrets`,
# which generates strong values, rather than copying this by hand.

# Encrypts credentials stored by n8n.
N8N_ENCRYPTION_KEY=

# Shared by n8n and its task runner sidecar.
N8N_RUNNERS_AUTH_TOKEN=

# One secret per direction, so leaking one doesn't allow forging the other.
LENDLOOP_TO_N8N_SECRET=
N8N_TO_LENDLOOP_SECRET=

# Where n8n reaches Convex HTTP actions. Use https://<name>.convex.site in the cloud.
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Optional. Defaults send mail to the local Mailpit container.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# LENDLOOP_OPS_EMAIL=
