    {
      "id": "00000000-0000-4000-8000-000000000018",
      "name": "Build write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Serialize once and sign that exact string: the bytes signed are the bytes sent.\nconst body = JSON.stringify({ eventId: $json.eventId, status: $json.status });\nconst timestamp = String(Math.floor(Date.now() / 1000));\nreturn {\n  json: {\n    body,\n    timestamp,\n    signingString: `${timestamp}.POST./n8n/notifications.${body}`,\n    status: $json.status,\n  },\n};"
      }
    },
