      "id": "00000000-0000-4000-8000-000000000009",
      "name": "Drop repeated deliveries",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.event.deliveryKey }}",
        "options": {
          "scope": "workflow"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000010",
      "name": "Compose message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { eventId, type, recipient, loan } = $json.event;\nconst dates = `${loan.startDate} to ${loan.endDate}`;\n\nconst messages = {\n  \"loan.requested\": {\n    subject: `Someone wants to borrow your ${loan.toolName}`,\n    body: `A neighbor asked to borrow your ${loan.toolName} from ${dates}. Open LendLoop to approve or decline.`,\n  },\n  \"loan.approved\": {\n    subject: `Your request for the ${loan.toolName} was approved`,\n    body: `You can borrow the ${loan.toolName} from ${dates}.`,\n  },\n  \"loan.declined\": {\n    subject: `Your request for the ${loan.toolName} was declined`,\n    body: `The ${loan.toolName} isn't available for ${dates}. Try other dates or another tool on the board.`,\n  },\n  \"loan.cancelled\": {\n    subject: `A request for your ${loan.toolName} was cancelled`,\n    body: `The borrower cancelled the request for ${dates}. Your tool stays free for those dates.`,\n  },\n  \"loan.returned\": {\n    subject: `Thanks for returning the ${loan.toolName}`,\n    body: `The owner confirmed that the ${loan.toolName} came back. This loan is closed.`,\n  },\n};\n\nconst message = messages[type];\nif (!message) throw new Error(`Unknown event type: ${type}`);\n\nreturn {\n  json: {\n    eventId,\n    to: recipient.email,\n    subject: message.subject,\n    text: `Hi ${recipient.firstName},\\n\\n${message.body}\\n\\nLendLoop`,\n  },\n};"
      }
    },
